{
  "schema_version": 1,
  "kind": "mock_templates",
  "about": "The kit templates as HTML and CSS, rendered to PNG by scripts/render_mocks.mjs; render/KIT.md says which rules come from the published artwork and which are read into it. Each field is text (escaped, a newline is a line break), rows (a list of [name, value] pairs or [name, note, value] triples; an arrow in a value is drawn) or options (a list of strings). A field named in choices takes one of the listed words. The examples hold placeholder text only: real ideas, claims and mocks never enter this repository.",
  "kit": {
    "colours": {
      "ink": "#0C1512",
      "ink_deep": "#070D0B",
      "cream": "#F4EFE4",
      "green": "#2F6B5C",
      "mint": "#7EF0C0",
      "butter": "#FFD84D",
      "coral": "#FF6A4D",
      "lilac": "#B7A6FF"
    },
    "fonts": {
      "heading": "Anton",
      "subheading": "Fraunces",
      "body": "Archivo",
      "label": "IBM Plex Mono"
    },
    "margin_px": 108,
    "footer": "makeyourmindup.ai",
    "fonts_source": "github.com/google/fonts, branch main, folders ofl/anton, ofl/fraunces, ofl/archivo and ofl/ibmplexmono; each family keeps its SIL Open Font License beside it in render/fonts"
  },
  "templates": {
    "quote-card": {
      "file": "templates/quote-card.html",
      "width": 1080,
      "height": 1350,
      "fields": {
        "label": "text",
        "quote": "text",
        "source": "text"
      },
      "required": [
        "label",
        "quote"
      ],
      "example": {
        "label": "series.label",
        "quote": "One plain sentence, quoted word for word from the published piece.",
        "source": "From the piece title, with its date"
      }
    },
    "receipt-card": {
      "file": "templates/receipt-card.html",
      "width": 1600,
      "height": 900,
      "fields": {
        "label": "text",
        "headline": "text",
        "facts": "text",
        "source": "text",
        "accent": "text",
        "tone": "text"
      },
      "required": [
        "label",
        "headline",
        "facts"
      ],
      "example": {
        "label": "series.label",
        "headline": "One short line",
        "facts": "The first fact, with its number.\nThe second fact, with its number.",
        "source": "Source name, with its date",
        "accent": "that says what happened"
      },
      "choices": {
        "tone": [
          "butter",
          "mint",
          "coral"
        ]
      },
      "note": "headline is the cream lines, accent the one line in the tone colour (butter unless tone says mint or coral)."
    },
