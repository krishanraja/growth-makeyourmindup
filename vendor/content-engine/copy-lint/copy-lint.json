{
  "version": "2026-11-01.1",
  "ruling": "Krish, 2026-10-28: \"don't add stupid eyebrow text and asterisks and \"generated by AI\" and \"Krish's take\" verbal diahorrea like you tend to. This needs to feel like a world class media channel\". With his 26 October 2026 ruling that no illustration-generation boilerplate goes on public artwork, captions or descriptions (docs/CAROUSEL-STANDARD.md). And on 28 October, of the labels on screen: \"It's just the ones that say \"Krish's read\" or \"illustrative\" that are stupid because they add no value to the content.\" And on 28 October, of his name: \"Remember, no content refers to Krish, ever. I still see that popping up from time to time. Even articles written are not authored by Krish. My face only, for assets and the video format.\" Asked on 29 October whether another person called Krish may be named, Krish picked: \"Yes, block it\". Applies to channel copy, carousel text, on-screen words, titles and article metadata. Only the name rule also reads the article body; no other pattern ever reads the body's markdown source, where emphasis and headings are the markdown itself.",
  "patterns": [
    {
      "id": "asterisk",
      "regex": "[*∗＊]",
      "flags": "",
      "reason": "No asterisks in public copy: no footnote stars, no markdown bold or italics. Say it in the words.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "markdown_emphasis",
      "regex": "(?<![\\w/@])_{1,2}(?=\\S)[^_\\n]+?(?<=\\S)_{1,2}(?!\\w)",
      "flags": "",
      "reason": "Markdown emphasis (_word_ or __word__) shows up as raw underscores on every platform. Plain words only.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "eyebrow_label",
      "regex": "(?:^|[\\[(【])[ \\t]*(?:[^\\w\\s][ \\t]*)*(?:breaking(?:[ \\t]+news)?|just[ \\t]+in|ai[ \\t]+news|big[ \\t]+news|news[ \\t]?flash|must[-\\s](?:read|watch|see)|exclusive|psa|alert|trending|thread|tl;?dr|new|fresh|deep[ \\t]+dive|explainer|opinion|analysis|editor(?:'|’)?s[ \\t]+(?:note|pick)|did[ \\t]+you[ \\t]+know|fun[ \\t]+fact|pro[ \\t]+tip|quick[ \\t]+tip|top[ \\t]+tip|hot[ \\t]+off[ \\t]+the[ \\t]+press|this[ \\t]+week[ \\t]+in[ \\t]+ai|weekly[ \\t]+(?:roundup|recap)|roundup|recap)[ \\t]*(?:[:|·•\\])】]|[-–][ \\t])|^[ \\t]*(?:[^\\w\\s][ \\t]*)*(?:breaking(?:[ \\t]+news)?|just[ \\t]+in|ai[ \\t]+news|big[ \\t]+news|news[ \\t]?flash|must[-\\s](?:read|watch|see)|exclusive|psa|tl;?dr|trending|this[ \\t]+week[ \\t]+in[ \\t]+ai)[ \\t]*(?:[^\\w\\s][ \\t]*)*$",
      "flags": "im",
      "reason": "An eyebrow or kicker label (\"BREAKING:\", \"AI NEWS\", \"Pro tip:\") in front of the copy. A world class channel opens on the point itself.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "bracket_tag",
      "regex": "^[ \\t]*(?:[^\\w\\s\\[【\"“‘'][ \\t]*)*[\\[【][ \\t]*[A-Z0-9][A-Z0-9 &'’.:/+#-]{0,23}[ \\t]*[\\]】](?!\\()|[\\[【][ \\t]*[A-Z0-9][A-Z0-9 &'’.:/+#-]{0,23}[ \\t]*[\\]】](?!\\()(?=[ \\t]*[.,;:!?)]*[ \\t]*$)|[\\[【][ \\t]*\\d{1,3}[ \\t]*[\\]】](?!\\()",
      "flags": "m",
      "reason": "A bracketed tag or footnote marker (\"[NEW]\", \"[VIDEO]\", \"[1]\"). No tags and no footnotes in public copy.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "caps_label_line",
      "regex": "^[ \\t]*(?:[^\\w\\s][ \\t]*)*[A-Z][A-Z&'’./+-]*(?:[ \\t]+[A-Z][A-Z&'’./+-]*){0,3}(?<!\\.)[ \\t]*:?[ \\t]*\\n(?=[ \\t\\n]*\\S)",
      "flags": "",
      "reason": "A short capitals-only label line on top of the copy (\"AI NEWS\", \"FOLLOW THE MONEY\"). Start on the first real sentence.",
      "applies_to": [
        "channel_copy",
        "article_metadata"
      ]
    },
    {
      "id": "series_label",
      "regex": "^[ \\t]*(?:follow\\.the\\.money|under\\.the\\.hood|mind\\.the\\.gap)[ \\t]*(?:[:|·•]|[-–][ \\t]|\\n(?=[ \\t\\n]*\\S))",
      "flags": "im",
      "reason": "The series name used as a label in front of the copy or the title. The channel and the cover already carry it.",
      "applies_to": [
        "channel_copy",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "ai_illustration_note",
      "regex": "\\b(?:illustrations?|artwork|scenes?|visuals?|stills?|graphics?|renders?|cover art)[ \\t]+(?:(?:was|were|is|are|has[ \\t]+been|have[ \\t]+been)[ \\t]+)?(?:(?:partly|partially|fully|entirely|mostly|all)[ \\t]+)?(?:(?:generated|created|made|produced|rendered|drawn|designed|animated|illustrated|written|edited|enhanced)[ \\t]+(?:with|by|using|via|in|through)[ \\t]+(?:the[ \\t]+help[ \\t]+of[ \\t]+)?(?:an?[ \\t]+)?(?:a\\.i\\.|ai(?:[-\\s](?:tools?|models?|tech|technology))?|artificial intelligence|generative ai|gen[-\\s]?ai|chat[-\\s]?gpt|gpt[-\\s]?\\d[\\w.]*|openai|dall[-\\s·]?e(?:[-\\s]?\\d)?|midjourney|runway(?:[-\\s]?ml)?|higgsfield|stable diffusion|firefly|ideogram|leonardo(?:\\.ai)?|kling|heygen|eleven[-\\s]?labs|nano banana|codex|sora|veo|imagen|gemini|claude|suno|udio|canva)|ai[-\\s]?(?:generated|created|made|assisted|enhanced|rendered|written|drawn))\\b|\\bai[-\\s]?(?:generated|created|made|assisted)[ \\t]+(?:editorial[ \\t]+)?(?:illustrations?|artwork)\\b",
      "flags": "i",
      "reason": "Illustration-generation boilerplate (\"illustration generated with AI\"). Provenance stays private and in native platform metadata, never in the copy.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "ai_self_note",
      "regex": "\\b(?:this|these|our|my)[ \\t]+(?:[\\w'’-]+[ \\t]+)?(?:images?|pictures?|photos?|videos?|clips?|footage|thumbnails?|covers?|music|voiceover|voice|art|artwork|illustrations?|visuals?|graphics?|scenes?|stills?|renders?|animations?|slides?|carousel|posts?|captions?|copy|content|scripts?|articles?|pieces?)[ \\t]+(?:was|were|is|are|has[ \\t]+been|have[ \\t]+been)[ \\t]+(?:(?:partly|partially|fully|entirely|mostly|all)[ \\t]+)?(?:ai[-\\s]?(?:generated|created|made|assisted|enhanced|rendered|written|drawn)|(?:generated|created|made|produced|rendered|drawn|designed|animated|illustrated|written|edited|enhanced)[ \\t]+(?:with|by|using|via|in|through)[ \\t]+(?:the[ \\t]+help[ \\t]+of[ \\t]+)?(?:an?[ \\t]+)?(?:a\\.i\\.|ai(?:[-\\s](?:tools?|models?|tech|technology))?|artificial intelligence|generative ai|gen[-\\s]?ai|chat[-\\s]?gpt|gpt[-\\s]?\\d[\\w.]*|openai|dall[-\\s·]?e(?:[-\\s]?\\d)?|midjourney|runway(?:[-\\s]?ml)?|higgsfield|stable diffusion|firefly|ideogram|leonardo(?:\\.ai)?|kling|heygen|eleven[-\\s]?labs|nano banana|codex|sora|veo|imagen|gemini|claude|suno|udio|canva))\\b",
      "flags": "i",
      "reason": "A note that this post, picture or video was made with AI (\"this video was made with Runway\"). Never in public copy.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "ai_provenance_label",
      "regex": "(?:^|[(\\[|·•]|[.!?][ \\t]+)[ \\t]*(?:(?:images?|pictures?|photos?|videos?|clips?|footage|thumbnails?|covers?|music|voiceover|voice|art|artwork|illustrations?|visuals?|graphics?|scenes?|stills?|renders?|animations?|slides?|carousel|posts?|captions?|copy|content|scripts?|articles?|pieces?)[ \\t]+)?(?:(?:generated|created|made|produced|rendered|drawn|designed|animated|illustrated|written|edited|enhanced)[ \\t]+(?:with|by|using|via|in|through)[ \\t]+(?:the[ \\t]+help[ \\t]+of[ \\t]+)?(?:an?[ \\t]+)?(?:a\\.i\\.|ai(?:[-\\s](?:tools?|models?|tech|technology))?|artificial intelligence|generative ai|gen[-\\s]?ai|chat[-\\s]?gpt|gpt[-\\s]?\\d[\\w.]*|openai|dall[-\\s·]?e(?:[-\\s]?\\d)?|midjourney|runway(?:[-\\s]?ml)?|higgsfield|stable diffusion|firefly|ideogram|leonardo(?:\\.ai)?|kling|heygen|eleven[-\\s]?labs|nano banana|codex|sora|veo|imagen|gemini|claude|suno|udio|canva)(?:[ \\t]*(?:,|and|&|\\+)[ \\t]*(?:a\\.i\\.|ai(?:[-\\s](?:tools?|models?|tech|technology))?|artificial intelligence|generative ai|gen[-\\s]?ai|chat[-\\s]?gpt|gpt[-\\s]?\\d[\\w.]*|openai|dall[-\\s·]?e(?:[-\\s]?\\d)?|midjourney|runway(?:[-\\s]?ml)?|higgsfield|stable diffusion|firefly|ideogram|leonardo(?:\\.ai)?|kling|heygen|eleven[-\\s]?labs|nano banana|codex|sora|veo|imagen|gemini|claude|suno|udio|canva))*|ai[-\\s]?(?:generated|created|made|assisted|enhanced|rendered|written|drawn)(?:[ \\t]+(?:images?|pictures?|photos?|videos?|clips?|footage|thumbnails?|covers?|music|voiceover|voice|art|artwork|illustrations?|visuals?|graphics?|scenes?|stills?|renders?|animations?|slides?|carousel|posts?|captions?|copy|content|scripts?|articles?|pieces?))?)[ \\t]*(?=$|[)\\].,;:|·•])",
      "flags": "im",
      "reason": "A provenance note standing on its own (\"Generated by AI\", \"(AI-generated)\", \"Made with Midjourney.\"). Never on our own work. Credit someone else's footage or image as \"Source: <owner>\", and say who made someone else's work in a sentence (\"Runway made the ad\").",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "ai_credit_line",
      "regex": "(?:^|[(\\[|·•]|[.!?][ \\t]+)[ \\t]*(?:images?|pictures?|photos?|videos?|clips?|footage|thumbnails?|covers?|music|voiceover|voice|art|artwork|illustrations?|visuals?|graphics?|scenes?|stills?|renders?|animations?|slides?|carousel|posts?|captions?|copy|content|scripts?|articles?|pieces?)[ \\t]*(?::|by|via|courtesy[ \\t]+of|from)[ \\t]*(?:an?[ \\t]+)?(?:a\\.i\\.|ai(?:[-\\s](?:tools?|models?|tech|technology))?|artificial intelligence|generative ai|gen[-\\s]?ai|chat[-\\s]?gpt|gpt[-\\s]?\\d[\\w.]*|openai|dall[-\\s·]?e(?:[-\\s]?\\d)?|midjourney|runway(?:[-\\s]?ml)?|higgsfield|stable diffusion|firefly|ideogram|leonardo(?:\\.ai)?|kling|heygen|eleven[-\\s]?labs|nano banana|codex|sora|veo|imagen|gemini|claude|suno|udio|canva)(?:[ \\t]*(?:,|and|&|\\+)[ \\t]*(?:a\\.i\\.|ai(?:[-\\s](?:tools?|models?|tech|technology))?|artificial intelligence|generative ai|gen[-\\s]?ai|chat[-\\s]?gpt|gpt[-\\s]?\\d[\\w.]*|openai|dall[-\\s·]?e(?:[-\\s]?\\d)?|midjourney|runway(?:[-\\s]?ml)?|higgsfield|stable diffusion|firefly|ideogram|leonardo(?:\\.ai)?|kling|heygen|eleven[-\\s]?labs|nano banana|codex|sora|veo|imagen|gemini|claude|suno|udio|canva))*[ \\t]*(?=$|[)\\].,;:|·•])",
      "flags": "im",
      "reason": "A credit line naming AI or an AI tool as the maker (\"Image: Midjourney\", \"Visuals by AI\"). Our own pictures carry no credit. Credit someone else's footage or image as \"Source: <owner>\", and say who made someone else's work in a sentence (\"Runway made the ad\").",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "ai_media_label",
      "regex": "[(\\[][ \\t]*ai[-\\s]?(?:images?|illustrations?|art|artwork|visuals?|pictures?|photos?|renders?|videos?|footage|clips?)[ \\t]*[)\\]]|^[ \\t]*ai[-\\s](?:images?|illustrations?|art|artwork|visuals?|pictures?|photos?|renders?)[ \\t]*(?:$|(?:by|via|from)\\b)",
      "flags": "im",
      "reason": "An \"AI image\" style tag on a picture or a post. An approved still carries no tag at all (Krish, 28 Oct 2026: \"I hate all these stupid little abbreviations and marks\").",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "illustration_label",
      "regex": "(?:^|[|·•(\\[])[ \\t]*(?:[^\\w\\s][ \\t]*)*(?:for[ \\t]+)?(?:illustrative|illustration|ai[ \\t]+example)(?:[ \\t]+(?:only|examples?|ai|images?|scenes?|stills?|visuals?|figures?|numbers?|data|day|week|month|year|scenario|case|purposes(?:[ \\t]+only)?))?\\b[ \\t]*(?:[:|·•\\])]|[-–][ \\t]|(?:[^\\w\\s][ \\t]*)*$)",
      "flags": "im",
      "reason": "An \"illustrative\" or \"illustration\" label (\"ILLUSTRATIVE AI\", \"ILLUSTRATION\", \"AI EXAMPLE\", \"(illustrative)\"). Krish, 28 Oct 2026: these \"add no value to the content\". If a limitation changes what a claim means, say so in a plain sentence (docs/CAROUSEL-STANDARD.md).",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "take_label",
      "regex": "\\bkrish(?:'|’)?s[ \\t]+(?:take|read|test|verdict|view|opinion|assessment|thoughts?|two[ \\t]+cents|pov)\\b|(?:^|[\\[(|·•])[ \\t]*(?:[^\\w\\s][ \\t]*)*(?:(?:my|our|hot|quick|spicy|honest|his)[ \\t]+take|(?:my|our|his)[ \\t]+read)[ \\t]*(?:[:|·•\\])]|[-–][ \\t]|$)|\\b(?:(?:my|our|hot|quick|spicy|honest)[ \\t]+take|(?:my|our)[ \\t]+read)[ \\t]*:",
      "flags": "im",
      "reason": "A personal-take label (\"Krish's take\", \"Krish's read\", \"My take:\", \"Hot take:\"). The piece is his take; it never says so.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "no_name",
      "regex": "(?<![a-z])(?:the[ \\t_.-]?real[ \\t_.-]?krisho|krisho|krish(?:an)?raja\\d*|krish(?:an)?(?:[ \\t]+raja)?)(?![a-z])",
      "flags": "i",
      "reason": "His name, a spelling or handle of it, or a possessive of it (\"By Krish Raja\", \"Krish's test\", \"@TheRealKrisho\", \"krishraja.com\"). No public content names him or credits him as its author; his face is the only part of him that appears, in assets and video. Every Krish is refused, another person called Krish too, with no override (Krish picked: \"Yes, block it\"). A label for a test the publication ran reads OUR TEST by default.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata",
        "article_body"
      ]
    },
    {
      "id": "markdown_heading",
      "regex": "^[ \\t]{0,3}#{1,6}[ \\t]+\\S",
      "flags": "m",
      "reason": "A Markdown heading (#, ##) shows as raw hash marks on LinkedIn, X, Threads and Facebook. Krish, 2026-11-01, on the article: \"Growth engine will start auto posting this through Buffer and we cannot risk crappy formatting.\" Write the line as words.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "markdown_link",
      "regex": "\\[[^\\]\\n]+\\]\\((?:https?://|/)[^)\\s]*\\)",
      "flags": "",
      "reason": "A Markdown link ([text](url)) shows its brackets and the raw address on every social platform. Put the plain link where the channel takes it.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "markdown_quote",
      "regex": "^[ \\t]*>[ \\t]",
      "flags": "m",
      "reason": "A Markdown quote mark (>) at the start of a line shows as a raw angle bracket. Quote in quotation marks.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    },
    {
      "id": "backtick",
      "regex": "`",
      "flags": "",
      "reason": "A backtick is code formatting and shows as a raw mark in public copy. Plain words only.",
      "applies_to": [
        "channel_copy",
        "carousel_text",
        "video_onscreen",
        "titles",
        "article_metadata"
      ]
    }
  ]
