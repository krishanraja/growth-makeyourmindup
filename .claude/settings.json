{
  "hooks": {
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/taste_backstop.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/scripts/taste_backstop.py\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/codex-login.sh\"",
            "timeout": 180,
            "statusMessage": "Checking Codex sign-in"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(create_post|edit_post)",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v python3 >/dev/null 2>&1; then python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/buffer-subscribe-gate.py\"; else python \"$CLAUDE_PROJECT_DIR/.claude/hooks/buffer-subscribe-gate.py\"; fi || exit 2"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "mcp__.*__(get_post|list_posts|create_post)",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/buffer-post-channels.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/buffer-post-channels.py\""
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  }
}
