{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "tool",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "guide": {
      "type": "string",
      "minLength": 1
    },
    "recheck_after_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    },
    "always_live_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "verified",
              "unverified",
              "unsupported"
            ]
          },
          "verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "channel",
          "format",
          "status",
          "verified_at",
          "evidence_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "guide",
    "recheck_after_days",
    "always_live_checks",
    "capabilities",
    "lessons"
  ],
  "additionalProperties": false
}
