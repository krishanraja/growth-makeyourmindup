{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "format",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "production_owner": {
      "type": "string",
      "enum": [
        "content-engine",
        "growth-canva"
      ]
    },
    "production_reference": {
      "type": "string",
      "minLength": 1
    },
    "channels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "guide": {
      "type": "string",
      "minLength": 1
    },
    "min_assets": {
      "type": "integer",
      "minimum": 0
    },
    "max_assets": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "delivery_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "measurements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "lessons": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "production_owner",
    "production_reference",
    "channels",
    "guide",
    "min_assets",
    "max_assets",
    "delivery_checks",
    "measurements",
    "lessons"
  ],
  "additionalProperties": false
}
