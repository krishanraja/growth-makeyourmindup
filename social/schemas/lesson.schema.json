{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "kind": {
      "const": "lesson",
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "category": {
      "type": "string",
      "enum": [
        "tool",
        "channel",
        "format",
        "account"
      ]
    },
    "scope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "status": {
      "type": "string",
      "enum": [
        "observed",
        "hypothesis",
        "accepted",
        "superseded"
      ]
    },
    "finding": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user_ruling",
            "live_readback",
            "published_source",
            "private_file"
          ]
        },
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date"
        },
        "result": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "ref",
        "observed_at",
        "result"
      ],
      "additionalProperties": false
    },
    "revisit_when": {
      "type": "string",
      "minLength": 1
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "category",
    "scope",
    "status",
    "finding",
    "evidence",
    "revisit_when",
    "supersedes"
  ],
  "additionalProperties": false
}
