{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Content backlog inventory",
  "description": "Every published piece against the channels and formats it could run on, oldest unamplified first. Written by growth.py backlog to .scratch/backlog/inventory.json; only this schema and a synthetic fixture are committed.",
  "type": "object",
  "required": ["schema_version", "kind", "observed_at", "feed_days", "sources", "channels", "summary", "pieces"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "backlog_inventory"},
    "observed_at": {"type": "string", "format": "date-time"},
    "feed_days": {"type": "integer", "minimum": 1, "maximum": 366},
    "sources": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "channels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["channel", "formats"],
        "additionalProperties": false,
        "properties": {
          "channel": {"type": "string", "minLength": 1},
          "formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "summary": {
      "type": "object",
      "required": ["pieces", "remaining", "partial", "covered", "editions_open"],
      "additionalProperties": false,
      "properties": {
        "pieces": {"type": "integer", "minimum": 0},
        "remaining": {"type": "integer", "minimum": 0},
        "partial": {"type": "integer", "minimum": 0},
        "covered": {"type": "integer", "minimum": 0},
        "editions_open": {"type": "integer", "minimum": 0}
      }
    },
    "pieces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["piece_id", "url", "title", "kind", "published_at", "video_post_url", "status", "editions", "channels_open"],
        "additionalProperties": false,
        "properties": {
          "piece_id": {"type": "string", "pattern": "^piece_[0-9a-f]{20}$"},
          "url": {"type": "string", "pattern": "^https?://\\S+$"},
          "title": {"type": "string"},
          "kind": {"enum": ["article", "video post"]},
          "published_at": {"type": "string", "format": "date-time"},
          "video_post_url": {"type": ["string", "null"], "pattern": "^https?://\\S+$"},
          "status": {"enum": ["unamplified", "partial", "covered"]},
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["channel", "format", "source", "native_url"],
              "additionalProperties": false,
              "properties": {
                "channel": {"type": "string", "minLength": 1},
                "format": {"type": ["string", "null"], "minLength": 1},
                "source": {"enum": ["pilot", "ledger"]},
                "native_url": {"type": ["string", "null"], "pattern": "^https://\\S+$"}
              }
            }
          },
          "channels_open": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
